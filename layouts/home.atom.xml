{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom"><title>{{ site.Title }}</title><id>{{ site.Params.canonicalBase }}/</id><link href="{{ site.Params.canonicalBase }}/atom.xml" rel="self"/><updated>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</updated>{{ range first 30 (where (where site.RegularPages "Section" "posts") "Params.hidden" "ne" true) }}<entry><title>{{ .Title }}</title><id>{{ .Params.original_url | default .Permalink }}</id><link href="{{ .Params.original_url | default .Permalink }}"/><updated>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</updated><content type="html">{{ partial "legacy-content.html" . | html }}</content></entry>{{ end }}</feed>
