{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{{ $host := (urls.Parse site.BaseURL).Host }}{{ range site.Pages }}{{ $url := partial "canonical-url.html" . }}{{ if and (eq (urls.Parse $url).Host $host) (not .Params.hidden) }}<url><loc>{{ $url }}</loc>{{ if not .Lastmod.IsZero }}<lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>{{ end }}</url>{{ end }}{{ end }}</urlset>
